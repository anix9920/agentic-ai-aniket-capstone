# Copy this file to .env and fill in your OpenRouter API key (https://openrouter.ai/keys).
# The app runs without a key too - it falls back to deterministic templates and hashing embeddings.
OPENROUTER_API_KEY=
# Base URL for OpenRouter's OpenAI-compatible API.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Chat model used for recommendation impact text and the executive summary.
MODEL=meta-llama/llama-3.1-8b-instruct
# Embedding model for the RAG knowledge base. Alias: OPENROUTER_EMBEDDING_MODEL.
EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: preferred sample temperature for chat calls.
TEMPERATURE=0.2
