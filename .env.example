# Copy this file to .env and fill in your OpenAI API key (https://platform.openai.com/api-keys)
# The app runs without a key too - it falls back to deterministic templates.
OPENAI_API_KEY=
# Model used for recommendation impact text and the executive summary.
OPENAI_MODEL=gpt-4o-mini
# Sampling temperature for prose (0 = most deterministic).
OPENAI_TEMPERATURE=0.2
